{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@hanabi-live/game": ["../vendor/hanabi-live/packages/game/src/index.ts"],
      "hanabi-live-ui/*": ["../vendor/hanabi-live/packages/client/src/game/ui/*"]
    }
  },
  "include": ["src"]
}
